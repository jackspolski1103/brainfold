# Referencias y valores vacíos: jamás agregar credenciales reales al repositorio.
# La aplicación no carga .env automáticamente; usa variables del entorno del servicio.
OPENAI_API_KEY=
# Elegir un identificador disponible en la cuenta personal. No hay modelo predeterminado.
OIF_OPENAI_MODEL=

# Identidad de desarrollo: mapa de identidades a NOMBRES de variables, no a sus valores.
OIF_IDENTITY_ENV_MAP={"alice":"OIF_TOKEN_ALICE","bob":"OIF_TOKEN_BOB"}
OIF_TOKEN_ALICE=
OIF_TOKEN_BOB=

# En la terminal del CLI, usar el token correspondiente; nunca pasarlo como argumento.
OIF_ACCESS_TOKEN=

# Solo si una conexión MCP necesita su propia credencial:
# OIF_MCP_TOKEN_ENVS=OIF_MCP_ATLAS_TOKEN
# OIF_MCP_ATLAS_TOKEN=
